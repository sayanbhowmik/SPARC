# Collinear spin-polarized Si2 with zero initial magnetization.
# Closed-shell semiconductor: should stay non-magnetic and match Si2_nmag DOS.

SPIN_TYP: 1

LATVEC:
 0.5  0.5  0.0
 0.0  0.5  0.5
 0.5  0.0  0.5
LATVEC_SCALE: 10.606601717798211 10.606601717798211 10.606601717798211

KPOINT_GRID: 2 2 2
BC: P P P
MESH_SPACING: 0.55

EXCHANGE_CORRELATION: GGA_PBE
TOL_SCF: 1e-5
SMEARING: 0.001
ELEC_TEMP_TYPE: fd
NSTATES: 12
MAXIT_SCF: 100
MIXING_PRECOND_MAG: none
MIXING_PARAMETER_MAG: 4.0

PRINT_DENSITY: 1
CALC_STRESS: 1
PRINT_EIGEN: 1
PRINT_ORBITAL: 1
